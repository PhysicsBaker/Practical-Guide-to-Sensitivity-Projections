Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "4.24", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"qo2", "[", "o_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"Log", "[", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"HBSM", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "/", "Ntotal"}], ")"}], 
           RowBox[{"o", "[", 
            RowBox[{"[", "i", "]"}], "]"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"HBSM", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "/", "Ntotal"}], ")"}], 
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "i", "]"}], "]"}]]], " ", 
         FractionBox[
          RowBox[{
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "!"}], 
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "!"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}], "]"}]}], "//",
     "N"}]}]}]], "Input",
