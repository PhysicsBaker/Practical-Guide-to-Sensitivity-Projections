 CellLabel->"In[40]:=",ExpressionUUID->"758a3eff-734c-4442-8841-65ea75e67f28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qo3", "[", "o_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"HBSM", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"HSM", "[", 
           RowBox[{"[", "i", "]"}], "]"}]], "]"}]}], "+", 
       RowBox[{"HSM", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "-", 
       RowBox[{"HBSM", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}]}], "//", 
   "N"}]}]], "Input",
 CellChangeTimes->{{3.99986595808108*^9, 3.9998659785713*^9}, {
  3.999866024168413*^9, 3.999866024561018*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"b547705c-bca9-4a98-9773-21b96f5e721b"],

