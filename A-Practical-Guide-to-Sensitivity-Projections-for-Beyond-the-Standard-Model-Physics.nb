Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "number", " ", "of", " ", "ways", " ", "of", " ", "of", " ", 
    "placing", " ", "\|01d441", " ", "balls", " ", "into", " ", "\|01d440", " ",
     "bins", " ", "is"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numberOfWays", "[", 
     RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
    RowBox[{"Binomial", "[", 
     RowBox[{
      RowBox[{"n", "+", "m", "-", "1"}], ",", "n"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PossibilitiesModule", "[", 
     RowBox[{"photons_", ",", "bins_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "unpermutedPossibilities", "}"}], ",", 
      RowBox[{
       RowBox[{"unpermutedPossibilities", "=", 
        RowBox[{"IntegerPartitions", "[", 
         RowBox[{"photons", ",", 
          RowBox[{"{", "bins", "}"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "photons"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Permutations", "[", 
            RowBox[{"unpermutedPossibilities", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "unpermutedPossibilities", "]"}]}], 
            "}"}]}], "]"}], ",", "1"}], "]"}]}]}], "]"}]}]}]}]], "Input",
