  RowBox[{"Timing", "[", 
   RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"qBSM", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FindMaximum", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"drawsBSM", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                   RowBox[{"Log", "[", 
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{
                    RowBox[{"HBSM", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " "}], 
                    RowBox[{
                    RowBox[{"H", "[", "\[Mu]", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], ")"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}]}], 
               "//", "N"}], ",", 
              RowBox[{"0", "<=", "\[Mu]", "<=", "1"}]}], "}"}], ",", "\[Mu]", 
            ",", 
            RowBox[{"PrecisionGoal", "->", "3"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "NMC"}], "}"}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", ",", 
