  RowBox[{
   RowBox[{"PGo", "[", "o_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"[", "i", "]"}], "]"}], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"HBSM", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"o", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "10"}]]}], "]"}]], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}]}], "//", 
