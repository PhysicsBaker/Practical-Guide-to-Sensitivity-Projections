  RowBox[{"(*", "3.66", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"H", "[", "\[Mu]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Mu]", " ", "HBSM"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Mu]"}], ")"}], "HSM"}]}]}]}]], "Input",
