Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "3.33", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"qo2", "[", "o_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "j", "]"}], "]"}], 
           RowBox[{"o", "[", 
            RowBox[{"[", "j", "]"}], "]"}]], 
          SuperscriptBox[
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "j", "]"}], "]"}], 
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "j", "]"}], "]"}]]], 
         FractionBox[
          RowBox[{
           RowBox[{"HBSM", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "!"}], 
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "!"}]]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}]}], "//", 
    "N"}]}]}]], "Input",
 CellChangeTimes->{{3.999859375624921*^9, 3.999859428464172*^9}, 
   3.999865829777568*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"ba3aef05-ad7b-4b3a-ab3a-cda2a14f7058"],

