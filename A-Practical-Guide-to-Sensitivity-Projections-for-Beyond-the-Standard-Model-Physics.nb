Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "3.68", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Timing", "[", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"qBSM", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FindMaximum", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"drawsBSM", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], 
                   RowBox[{"Log", "[", 
                    FractionBox[
                    RowBox[{"HBSM", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{
                    RowBox[{"H", "[", "\[Mu]", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "]"}]}], "-", 
                  RowBox[{"HBSM", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"H", "[", "\[Mu]", "]"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "[", "HBSM", "]"}]}], "}"}]}], "]"}]}], ",", 
              RowBox[{"0", "<=", "\[Mu]", "<=", "1"}]}], "}"}], ",", "\[Mu]", 
            ",", 
            RowBox[{"PrecisionGoal", "->", "3"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "NMC"}], "}"}]}], "]"}]}], ";"}], ",", 
     RowBox[{"{", "j", "}"}]}], "]"}], "]"}]}]], "Input",
