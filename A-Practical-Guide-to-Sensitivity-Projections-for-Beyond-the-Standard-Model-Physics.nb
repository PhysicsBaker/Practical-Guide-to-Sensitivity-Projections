Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "4.44", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Chi]2", "[", 
    RowBox[{"H_", ",", "A_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"H", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", 
          RowBox[{"A", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "2"], 
       RowBox[{"H", "[", 
        RowBox[{"[", "i", "]"}], "]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "H", "]"}]}], "}"}]}], "]"}], "//", 
    "N"}]}]}]], "Input",
 CellChangeTimes->{{3.999859721352454*^9, 3.9998597907857533`*^9}, {
  3.9998603728286133`*^9, 3.999860376395752*^9}, {3.9998658553918533`*^9, 
