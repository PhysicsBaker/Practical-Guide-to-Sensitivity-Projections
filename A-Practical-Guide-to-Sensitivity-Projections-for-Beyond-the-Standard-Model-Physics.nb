Cell["\<\
Asymptotic Limit of the Test Statistic of the Asimov Data Set\
\>", "Text",
 CellChangeTimes->{
  3.999859707231304*^9},ExpressionUUID->"e0834d59-2718-40ee-8402-\
c6e64dbcc9c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "3.55", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Chi]2", "[", 
    RowBox[{"H_", ",", "A_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"H", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", 
          RowBox[{"A", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "2"], 
       RowBox[{"H", "[", 
        RowBox[{"[", "i", "]"}], "]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "H", "]"}]}], "}"}]}], "]"}], "//", 
    "N"}]}]}]], "Input",
 CellChangeTimes->{{3.999859721352454*^9, 3.9998597907857533`*^9}, {
  3.9998603728286133`*^9, 3.999860376395752*^9}, {3.9998658553918533`*^9, 
  3.999865856760993*^9}, {4.001559053452085*^9, 4.0015590538023863`*^9}, {
